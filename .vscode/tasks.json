{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run (mvn compile exec:exec)",
            "type": "shell",
            "command": "mvn",
            "args": ["compile", "exec:exec"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Package Shaded JAR (mvn clean package)",
            "type": "shell",
            "command": "mvn",
            "args": ["clean", "package"],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}
