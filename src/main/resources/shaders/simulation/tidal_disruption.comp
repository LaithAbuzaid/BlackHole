#version 430 core
layout(local_size_x = 256) in;

struct Particle {
    vec4 posMass; // xyz = Cartesian position (M=1), w = mass (>0 active, <=0 captured/inactive)
    vec4 velTemp; // xyz = velocity, w = temperature (Kelvin)
};

layout(std430, binding = 0) buffer ParticleBuffer {
    Particle particles[];
};

layout(std430, binding = 1) buffer CounterBuffer {
    uint activeCount;
    uint shearCount;
    uint boundCount;
    uint unboundCount;
    uint swallowedCount;
};

uniform uint uParticleCount;
uniform float uDt;
uniform float uSpinA;
uniform float uHorizonR;
uniform int uCountSnapshot;       // 1 on final substep of the frame; swallowedCount accumulates on all substeps
uniform vec2 uSlotShockBeta[2];   // .x = archetype shockGain, .y = penetration factor beta

// Relativistic Paczynski-Wiita gravitational acceleration + Kerr Lense-Thirring frame-dragging torque
vec3 computeAccel(vec3 pos, vec3 vel, float spinA, float rPlus) {
    float r2 = dot(pos, pos);
    float r = sqrt(max(1e-5, r2));

    // Paczynski-Wiita pseudo-Newtonian potential smoothly calibrated to Kerr outer horizon r_+
    float rPw = max(0.32, r - 0.88 * rPlus);
    vec3 aGrav = (-1.0 / (rPw * rPw * r)) * pos;

    // Gravitomagnetic Kerr frame-dragging torque around +Y spin axis (prograde along (-z, 0, +x))
    vec3 aKerr = vec3(0.0);
    if (spinA > 0.001) {
        float invR3 = 1.0 / max(1.0, r2 * r);
        vec3 spinVec = vec3(0.0, spinA, 0.0);
        vec3 jCrossV = cross(spinVec, vel);
        vec3 rCrossV = cross(pos, vel);
        aKerr = (2.0 * invR3) * (jCrossV - (3.0 * dot(spinVec, pos) / max(1.0, r2)) * rCrossV);

        float rho2 = dot(pos.xz, pos.xz);
        if (rho2 > 1e-4) {
            vec3 phiPro = vec3(-pos.z, 0.0, pos.x) * inversesqrt(rho2);
            aKerr += phiPro * (0.45 * spinA * invR3 / max(1.0, r));
        }
    }

    return aGrav + aKerr;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= uParticleCount) {
        return;
    }

    Particle p = particles[idx];
    if (p.posMass.w <= 0.0) {
        return;
    }

    uint slot = (idx >> 16u) & 1u;
    float shockGain = uSlotShockBeta[slot].x;
    float slotBeta = uSlotShockBeta[slot].y;
    float massVal = p.posMass.w;

    vec3 pos = p.posMass.xyz;
    vec3 vel = p.velTemp.xyz;
    float temp = p.velTemp.w;

    // 2 substeps of Velocity-Verlet integration per dispatch for crisp periapsis conservation
    float dtSub = uDt * 0.5;
    bool swallowed = false;
    bool escapedFar = false;

    for (int sub = 0; sub < 2; sub++) {
        vec3 a0 = computeAccel(pos, vel, uSpinA, uHorizonR);
        vec3 vHalf = vel + a0 * (0.5 * dtSub);
        pos += vHalf * dtSub;

        float r = length(pos);
        if (r <= uHorizonR * 1.03) {
            swallowed = true;
            break;
        }
        if (r > 118.0) {
            escapedFar = true;
            break;
        }

        vec3 a1 = computeAccel(pos, vHalf, uSpinA, uHorizonR);
        vel = vHalf + a1 * (0.5 * dtSub);

        // Relativistic speed ceiling c = 1
        float v2 = dot(vel, vel);
        if (v2 > 0.90) {
            vel *= inversesqrt(v2) * 0.948;
            v2 = 0.90;
        }

        // Exact Paczynski-Wiita specific orbital energy: epsilon = 0.5*v^2 - 1/(r - 0.88*r_+)
        float rPw = max(0.32, r - 0.88 * uHorizonR);
        float energy = 0.5 * v2 - (1.0 / rPw);

        // Stream self-intersection & shock circularization for bound returning debris (epsilon < 0)
        // Partial-disruption dense cores (low beta, high massVal) resist circularization so a surviving core escapes.
        float shockFlash = 0.0;
        if (energy < -0.002 && r < 8.6) {
            float coreSurvival = smoothstep(1.12, 0.72, slotBeta) * smoothstep(0.74, 0.92, massVal);
            float circScale = (1.0 - 0.85 * coreSurvival);

            vec3 rHat = pos / max(1e-4, r);
            float vRad = dot(vel, rHat);
            vec3 vTanVec = vel - vRad * rHat;
            float vTanLen = length(vTanVec);
            float eccProxy = abs(vRad) / max(0.08, sqrt(v2));

            // Mild relativistic apsidal precession & stream-crossing shock zone around r ~ 2.2..8.2M
            float shockZone = smoothstep(8.6, 3.0, r) * smoothstep(0.12, 0.62, eccProxy) * circScale;
            if (shockZone > 0.01) {
                // Radiate eccentric radial kinetic energy into heat while settling toward a luminous torus
                float dampRate = clamp(0.18 * shockZone * dtSub, 0.0, 0.22);
                vel -= rHat * (vRad * dampRate);

                // Gentle circularization nudge toward local Paczynski-Wiita circular speed
                float vCirc = min(0.72, sqrt(r / max(0.35, rPw * rPw)));
                if (vTanLen > 1e-4) {
                    vec3 tHat = vTanVec / vTanLen;
                    float targetTan = mix(vTanLen, vCirc, clamp(0.065 * shockZone * dtSub, 0.0, 0.12));
                    vel += tHat * (targetTan - vTanLen);
                }

                // Subtle vertical settling toward equatorial orbital plane during circularization shock
                vel.y *= (1.0 - clamp(0.06 * shockZone * dtSub, 0.0, 0.08));
                shockFlash = shockZone * (0.65 + 1.40 * v2) * shockGain;
            }
        }

        // Tidal shear + periapsis nozzle-compression + stream self-intersection shock heating
        float tidalGrad = 2.0 / max(2.0, r * r * r);
        float nozzleShock = 1.0 + 1.40 * exp(-pos.y * pos.y * 3.0) * smoothstep(7.8, 2.5, r);
        float shearHeat = (tidalGrad * (0.35 + v2) * nozzleShock * 50000.0 * shockGain
                         + shockFlash * 26000.0) * dtSub;
        float coolFloor = (energy >= 0.0) ? 2800.0 : 3600.0;
        float coolRate = (energy >= 0.0) ? 0.17 : 0.13;
        float radCool = max(0.0, temp - coolFloor) * coolRate * dtSub;
        temp = clamp(temp + shearHeat - radCool, 2400.0, 44000.0);
    }

    if (swallowed || escapedFar) {
        p.posMass.w = 0.0;
        particles[idx] = p;
        if (swallowed) {
            atomicAdd(swallowedCount, 1u);
        }
        return;
    }

    p.posMass.xyz = pos;
    p.velTemp.xyz = vel;
    p.velTemp.w = temp;
    particles[idx] = p;

    if (uCountSnapshot == 1) {
        atomicAdd(activeCount, 1u);
        float rNow = length(pos);
        float v2Now = dot(vel, vel);
        float rPwNow = max(0.32, rNow - 0.88 * uHorizonR);
        float epsNow = 0.5 * v2Now - (1.0 / rPwNow);
        if (epsNow < 0.0) {
            atomicAdd(boundCount, 1u);
        } else {
            atomicAdd(unboundCount, 1u);
        }
        if (rNow < 8.5 && temp > 10500.0) {
            atomicAdd(shearCount, 1u);
        }
    }
}
