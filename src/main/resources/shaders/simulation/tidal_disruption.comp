#version 430 core
layout(local_size_x = 256) in;

struct Particle {
    vec4 posMass; // xyz = Cartesian position (M=1), w = mass (>0 active, <=0 captured/inactive)
    vec4 velTemp; // xyz = velocity, w = temperature (Kelvin)
};

layout(std430, binding = 0) buffer ParticleBuffer {
    Particle particles[];
};

// 8-element telemetry & conservation counter SSBO (reduced in workgroup shared memory -> 256x less atomic contention)
layout(std430, binding = 1) buffer CounterBuffer {
    uint activeCount;
    uint shearCount;
    uint boundCount;
    uint unboundCount;
    uint swallowedCount;
    int  energySumFixed;  // sum(mass * epsilon * 256)
    int  angMomYSumFixed; // sum(mass * L_y * 256)
    uint peakTempK;       // atomicMax(temperature in Kelvin)
};

struct HydroCell {
    int massFixed;
    int momXFixed;
    int momYFixed;
    int momZFixed;
};

layout(std430, binding = 2) readonly buffer HydroGridBuffer {
    HydroCell cells[];
};

uniform uint uParticleCount;
uniform float uDt;
uniform int uSubsteps;            // In-shader substep loop count (particles stay in registers -> 1 dispatch/frame!)
uniform float uSpinA;
uniform float uHorizonR;
uniform int uHydroEnabled;        // 1 = 64^3 Eulerian-Lagrangian pressure & shock viscosity; 0 = pure gravity conservation
uniform vec2 uSlotShockBeta[2];   // .x = archetype shockGain, .y = penetration factor beta

const int GRID_DIM = 64;
const float GRID_HALF_EXTENT = 24.0;
const float CELL_SIZE = (2.0 * GRID_HALF_EXTENT) / float(GRID_DIM);
const float INV_CELL_SIZE = float(GRID_DIM) / (2.0 * GRID_HALF_EXTENT);
const float INV_FIXED_SCALE = 1.0 / 1024.0;

// Workgroup shared-memory reduction buffers (256 threads -> 1 global atomic set per workgroup)
shared uint sActive;
shared uint sShear;
shared uint sBound;
shared uint sUnbound;
shared uint sSwallowed;
shared int  sEnergyFixed;
shared int  sAngMomYFixed;
shared uint sPeakTemp;

// Standard Paczynski-Wiita gravitational acceleration: V(r) = -1 / (r - 2M) (exact Schwarzschild ISCO = 6M)
vec3 computePwGravity(vec3 pos) {
    float r2 = dot(pos, pos);
    float r = sqrt(max(1e-5, r2));
    float rPw = max(0.35, r - 2.0);
    return (-1.0 / (rPw * rPw * r)) * pos;
}

// Exact Lense-Thirring gravitomagnetic angular frequency Omega_LT for spin J = (0, -a, 0)
// (matches kerr_blackhole.frag spin handedness; force a_LT = v x Omega_LT does ZERO work!)
vec3 computeLenseThirringOmega(vec3 pos, float spinA) {
    if (spinA <= 0.001) {
        return vec3(0.0);
    }
    float r2 = max(1.0, dot(pos, pos));
    float invR = inversesqrt(r2);
    float invR3 = invR / r2;
    vec3 rHat = pos * invR;
    // B_g = (2 / r^3) * [3 * (J . rHat) * rHat - J], with J = (0, -spinA, 0)
    float jDotR = -spinA * rHat.y;
    return (2.0 * invR3) * (3.0 * jDotR * rHat + vec3(0.0, spinA, 0.0));
}

// Exact kinetic-energy-preserving Boris rotation for dv/dt = v x Omega_LT
// Strictly preserves |v| for any step size dt without energy drift or artificial azimuthal thrust!
vec3 borisRotate(vec3 v, vec3 omega, float dt) {
    vec3 t = 0.5 * dt * omega;
    float t2 = dot(t, t);
    vec3 s = t * (2.0 / (1.0 + t2));
    vec3 vPrime = v + cross(v, t);
    return v + cross(vPrime, s);
}

float cellDensity(ivec3 c) {
    if (any(lessThan(c, ivec3(0))) || any(greaterThanEqual(c, ivec3(GRID_DIM)))) {
        return 0.0;
    }
    uint flatIdx = uint((c.z * GRID_DIM + c.y) * GRID_DIM + c.x);
    return float(max(0, cells[flatIdx].massFixed)) * INV_FIXED_SCALE;
}

// Evaluates 64^3 grid polytropic pressure gradient (-grad P / rho) and momentum-conserving
// stream-intersection shock relaxation toward local cell bulk velocity vBar
void evaluateGridHydro(vec3 pos, vec3 vel, out vec3 aPressure, out vec3 vBulk, out float localDensity) {
    aPressure = vec3(0.0);
    vBulk = vel;
    localDensity = 0.0;

    vec3 gPos = (pos + vec3(GRID_HALF_EXTENT)) * INV_CELL_SIZE;
    ivec3 c = ivec3(floor(gPos));
    if (any(lessThan(c, ivec3(1))) || any(greaterThanEqual(c, ivec3(GRID_DIM - 1)))) {
        return;
    }

    uint flatIdx = uint((c.z * GRID_DIM + c.y) * GRID_DIM + c.x);
    HydroCell hc = cells[flatIdx];
    float m = float(max(0, hc.massFixed)) * INV_FIXED_SCALE;
    localDensity = m;
    if (m <= 1.5) {
        return;
    }

    vBulk = vec3(hc.momXFixed, hc.momYFixed, hc.momZFixed) * (INV_FIXED_SCALE / m);

    // Polytropic EOS P = K * rho^(5/3) for tidally shocked debris streams.
    // Outside the tidal zone (r > 13M), stellar pressure is balanced by self-gravity so net pressure
    // expansion activates smoothly as the star crosses the Roche tidal radius.
    float rDist = length(pos);
    float tidalRelease = smoothstep(13.5, 7.0, rDist);
    if (tidalRelease <= 0.001) {
        return;
    }

    float rhoXp = cellDensity(c + ivec3(1, 0, 0));
    float rhoXm = cellDensity(c - ivec3(1, 0, 0));
    float rhoYp = cellDensity(c + ivec3(0, 1, 0));
    float rhoYm = cellDensity(c - ivec3(0, 1, 0));
    float rhoZp = cellDensity(c + ivec3(0, 0, 1));
    float rhoZm = cellDensity(c - ivec3(0, 0, 1));

    const float K_EOS = 0.0000045;
    float pXp = K_EOS * pow(rhoXp, 1.6667);
    float pXm = K_EOS * pow(rhoXm, 1.6667);
    float pYp = K_EOS * pow(rhoYp, 1.6667);
    float pYm = K_EOS * pow(rhoYm, 1.6667);
    float pZp = K_EOS * pow(rhoZp, 1.6667);
    float pZm = K_EOS * pow(rhoZm, 1.6667);

    vec3 gradP = vec3(pXp - pXm, pYp - pYm, pZp - pZm) / (2.0 * CELL_SIZE);
    aPressure = (-gradP / max(12.0, m)) * tidalRelease;
    // Clamp numerical pressure spike on extreme core compaction
    float aLen = length(aPressure);
    if (aLen > 0.025) {
        aPressure *= 0.025 / aLen;
    }
}

void main() {
    if (gl_LocalInvocationID.x == 0u) {
        sActive = 0u;
        sShear = 0u;
        sBound = 0u;
        sUnbound = 0u;
        sSwallowed = 0u;
        sEnergyFixed = 0;
        sAngMomYFixed = 0;
        sPeakTemp = 0u;
    }
    barrier();

    uint idx = gl_GlobalInvocationID.x;
    bool valid = (idx < uParticleCount);
    Particle p = Particle(vec4(0.0), vec4(0.0));
    if (valid) {
        p = particles[idx];
        valid = (p.posMass.w > 0.0);
    }

    if (valid) {
        uint slot = (idx >> 16u) & 1u;
        float shockGain = uSlotShockBeta[slot].x;
        float massVal = p.posMass.w;

        vec3 pos = p.posMass.xyz;
        vec3 vel = p.velTemp.xyz;
        float temp = p.velTemp.w;

        // Single-dispatch in-register substep loop (2 Verlet-Boris inner steps per frame substep)
        int totalInner = max(1, uSubsteps) * 2;
        float dtSub = uDt * 0.5;
        bool swallowed = false;
        bool escapedFar = false;

        // Sample 64^3 hydro grid once per dispatch if hydrodynamics mode is enabled
        vec3 hydroPressAcc = vec3(0.0);
        vec3 cellBulkVel = vel;
        float cellRho = 0.0;
        if (uHydroEnabled == 1) {
            evaluateGridHydro(pos, vel, hydroPressAcc, cellBulkVel, cellRho);
        }

        for (int sub = 0; sub < totalInner; sub++) {
            // 1. Half gravitational (+ hydro pressure if enabled) kick at x_n
            vec3 a0 = computePwGravity(pos) + hydroPressAcc;
            vel += a0 * (0.5 * dtSub);

            // 2. Half drift to midpoint x_{n+1/2}
            pos += vel * (0.5 * dtSub);

            // 3. Exact kinetic-energy-preserving Boris Lense-Thirring rotation at midpoint
            if (uSpinA > 0.001) {
                vec3 omegaLt = computeLenseThirringOmega(pos, uSpinA);
                vel = borisRotate(vel, omegaLt, dtSub);
            }

            // 4. Second half drift to x_{n+1}
            pos += vel * (0.5 * dtSub);

            float r = length(pos);
            if (r <= uHorizonR * 1.03) {
                swallowed = true;
                break;
            }
            if (r > 118.0) {
                escapedFar = true;
                break;
            }

            // 5. Second half gravitational (+ hydro pressure) kick at x_{n+1}
            vec3 a1 = computePwGravity(pos) + hydroPressAcc;
            vel += a1 * (0.5 * dtSub);

            // Relativistic speed ceiling c = 1
            float v2 = dot(vel, vel);
            if (v2 > 0.9025) {
                vel *= inversesqrt(v2) * 0.95;
                v2 = 0.9025;
            }

            // Separated hydrodynamics shock viscosity & thermal dissipation (ONLY when uHydroEnabled == 1)
            float shockDissipated = 0.0;
            if (uHydroEnabled == 1 && cellRho > 3.0) {
                // Momentum-conserving stream-intersection viscosity: relaxes relative velocity toward local cell bulk velocity
                vec3 vRel = vel - cellBulkVel;
                float vRel2 = dot(vRel, vRel);
                if (vRel2 > 1e-4) {
                    float viscRate = clamp(0.14 * min(1.0, cellRho / 45.0) * dtSub, 0.0, 0.16);
                    vec3 vNew = vel - vRel * viscRate;
                    float keBefore = 0.5 * v2;
                    float keAfter = 0.5 * dot(vNew, vNew);
                    shockDissipated = max(0.0, keBefore - keAfter);
                    vel = vNew;
                    v2 = dot(vel, vel);
                }
            }

            // Tidal compression + shock heating vs. physical radiative cooling
            float tidalGrad = 2.0 / max(2.0, r * r * r);
            float nozzleComp = 1.0 + 1.25 * exp(-pos.y * pos.y * 3.0) * smoothstep(9.0, 2.5, r);
            float heat = (tidalGrad * (0.35 + v2) * nozzleComp * 48000.0 * shockGain * dtSub)
                       + (shockDissipated * 220000.0 * shockGain);
            // Gentle radiative cooling so hot O-type photospheres & shocked tidal ribbons retain
            // their physical thermal ionization across the orbital plunge timescale
            float tRatio = temp / 8000.0;
            float radCool = (temp - 3000.0) * (0.012 + 0.0035 * tRatio * tRatio) * dtSub;
            temp = clamp(temp + heat - max(0.0, radCool), 3000.0, 44000.0);
        }

        if (swallowed || escapedFar) {
            p.posMass.w = 0.0;
            particles[idx] = p;
            if (swallowed) {
                atomicAdd(sSwallowed, 1u);
            }
        } else {
            p.posMass.xyz = pos;
            p.velTemp.xyz = vel;
            p.velTemp.w = temp;
            particles[idx] = p;

            atomicAdd(sActive, 1u);
            float rNow = length(pos);
            float v2Now = dot(vel, vel);
            float rPwNow = max(0.35, rNow - 2.0);
            float epsNow = 0.5 * v2Now - (1.0 / rPwNow);
            if (epsNow < 0.0) {
                atomicAdd(sBound, 1u);
            } else {
                atomicAdd(sUnbound, 1u);
            }
            if (rNow < 8.5 && temp > 10500.0) {
                atomicAdd(sShear, 1u);
            }
            // Conservation telemetry: specific energy & axial angular momentum L_y = x*vz - z*vx
            float angMomY = pos.x * vel.z - pos.z * vel.x;
            atomicAdd(sEnergyFixed, int(clamp(massVal * epsNow * 256.0, -32768.0, 32768.0)));
            atomicAdd(sAngMomYFixed, int(clamp(massVal * angMomY * 256.0, -32768.0, 32768.0)));
            atomicMax(sPeakTemp, uint(temp));
        }
    }

    barrier();

    if (gl_LocalInvocationID.x == 0u) {
        if (sActive > 0u) atomicAdd(activeCount, sActive);
        if (sShear > 0u) atomicAdd(shearCount, sShear);
        if (sBound > 0u) atomicAdd(boundCount, sBound);
        if (sUnbound > 0u) atomicAdd(unboundCount, sUnbound);
        if (sSwallowed > 0u) atomicAdd(swallowedCount, sSwallowed);
        if (sEnergyFixed != 0) atomicAdd(energySumFixed, sEnergyFixed);
        if (sAngMomYFixed != 0) atomicAdd(angMomYSumFixed, sAngMomYFixed);
        if (sPeakTemp > 0u) atomicMax(peakTempK, sPeakTemp);
    }
}
